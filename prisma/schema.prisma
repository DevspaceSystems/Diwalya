generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  WORKER
  ADMIN
  SUPER_ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JobStatus {
  PENDING
  ADMIN_REVIEW
  WORKER_REVIEW
  RESCHEDULE_REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobType {
  REGULAR
  INSPECTION
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String?
  name          String
  role          Role      @default(CLIENT)
  profilePicture String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  fcmToken      String?

  workerProfile   WorkerProfile?
  jobsAsClient    Job[]     @relation("ClientJobs")
  jobsAsWorker    Job[]     @relation("WorkerJobs")
  reviewsGiven    Review[]  @relation("ReviewsGiven")
  reviewsReceived Review[]  @relation("ReviewsReceived")
  wallet          Wallet?
  withdrawals     WithdrawalRequest[]
  specialRequests SpecialRequest[]
  reportsFiled    PlatformReport[] @relation("ReportsFiled")
  reportsReceived PlatformReport[] @relation("ReportsReceived")
  
  // Admin Controls
  isSuspended     Boolean  @default(false)
  isBanned        Boolean  @default(false)
  warningCount    Int      @default(0)
  suspensionReason String?
  
  messages        ChatMessage[]
  activities      ActivityLog[]
}

model WorkerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        String
  bio             String?
  experienceYears Int      @default(0)
  location        String
  hourlyRate      Float?
  isVerified      Boolean  @default(false)
  availability    String?  // Could be JSON or simple text
  portfolioImages String[] // Array of image URLs
  portfolioVideos String[] // Array of video URLs
  businessName    String?
  ghanaCardUrl    String?
  rejectionReason String?
  verificationStatus VerificationStatus @default(PENDING)
}

model Job {
  id          String   @id @default(cuid())
  clientId    String
  client      User     @relation("ClientJobs", fields: [clientId], references: [id])
  workerId    String
  worker      User     @relation("WorkerJobs", fields: [workerId], references: [id])
  serviceType String
  description String
  location    String
  scheduledAt DateTime
  status      JobStatus @default(PENDING)
  type        JobType   @default(REGULAR)
  priceAmount Float?
  assignedTeamMember String? // Optional Diwalya staff to accompany
  inspectionWorkerAmount Float? // Amount worker gets from inspection fee
  inspectionAdminAmount  Float? // Amount platform keeps
  isInspectionVerified   Boolean @default(false)
  inspectionNotes        String?
  workerConfirmedAt      DateTime?
  adminVerifiedAt        DateTime?
  paymentId   String?  @unique
  payment     Payment? @relation(fields: [paymentId], references: [id])
  createdAt   DateTime @default(now())
  
  review      Review?
  estimate    JobEstimate?
  messages    ChatMessage[]
}

model Payment {
  id            String   @id @default(cuid())
  amount        Float
  currency      String   @default("GHS")
  status        String   // PENDING, SUCCESS, FAILED
  reference     String   @unique // Paystack transaction reference
  createdAt     DateTime @default(now())
  
  job           Job?
}

model Review {
  id          String   @id @default(cuid())
  jobId       String   @unique
  job         Job      @relation(fields: [jobId], references: [id])
  authorId    String
  author      User     @relation("ReviewsGiven", fields: [authorId], references: [id])
  targetId    String
  target      User     @relation("ReviewsReceived", fields: [targetId], references: [id])
  rating      Int      // 1 to 5
  comment     String?
  createdAt   DateTime @default(now())
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Float    @default(0.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionPurpose {
  JOB_PAYMENT
  WITHDRAWAL
  PLATFORM_FEE
  REFUND
  INSPECTION_FEE
}

model Transaction {
  id        String             @id @default(cuid())
  walletId  String
  wallet    Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount    Float
  type      TransactionType
  purpose   TransactionPurpose
  reference String?            @unique // e.g. from Paystack or internal job ID
  status    String             @default("SUCCESS") // PENDING, SUCCESS, FAILED
  metadata  String?            // JSON string for extra info
  createdAt DateTime           @default(now())
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

enum WithdrawalMethod {
  MOMO
  BANK
}

model WithdrawalRequest {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Float
  status         WithdrawalStatus @default(PENDING)
  method         WithdrawalMethod 
  accountName    String
  accountNumber  String
  bankName       String?          // Required if BANK, e.g. MTN, Vodafone, GCB
  adminNotified  Boolean          @default(false)
  processedAt    DateTime?
  adminNotes     String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model SpecialRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceType   String
  description   String
  location      String
  preferredTime DateTime
  budget        Float?
  status        String   @default("PENDING") // PENDING, ASSIGNED, COMPLETED, CONTACTED
  adminNotes    String?
  assignedWorkerId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PlatformReport {
  id            String   @id @default(cuid())
  reporterId    String
  reporter      User     @relation("ReportsFiled", fields: [reporterId], references: [id])
  targetId      String
  target        User     @relation("ReportsReceived", fields: [targetId], references: [id])
  jobId         String?
  reason        String
  description   String
  evidenceUrls  String[]
  status        String   @default("PENDING") // PENDING, REVIEWED, RESOLVED, DISMISSED
  adminNotes    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ChatMessage {
  id        String   @id @default(cuid())
  jobId     String
  senderId  String
  content   String
  isFlagged Boolean  @default(false)
  createdAt DateTime @default(now())

  job    Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id])
}

enum ActivityType {
  REGISTRATION
  BOOKING_REQUEST
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  PAYMENT_COMPLETED
  WALLET_WITHDRAWAL
  REPORT_SUBMITTED
  VERIFICATION_REQUEST
  VERIFICATION_APPROVED
  SYSTEM_ALERT
  ADMIN_ACTION
}

model ActivityLog {
  id        String       @id @default(cuid())
  type      ActivityType
  content   String
  userId    String?
  metadata  Json?        // To store IDs like jobId, amount, etc.
  createdAt DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model SystemSettings {
  id                    String   @id @default("default")
  inspectionFee         Float    @default(100.0)
  inspectionWorkerShare Float    @default(60.0)
  updatedAt             DateTime @updatedAt
}

model JobEstimate {
  id                String   @id @default(cuid())
  jobId             String   @unique
  job               Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  laborCost         Float
  materialCost      Float
  totalCost         Float
  estimatedDuration String   // e.g. "5 days", "2 hours"
  workerNotes       String?  // Optional notes from worker
  status            String   @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED
  adminNotes        String?
  submittedAt       DateTime @default(now())
  reviewedAt        DateTime?
}
